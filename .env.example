# Copy to .env and fill in before deploying.
# Generate the secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

FCLASH_JWT_SECRET=change-me-to-a-long-random-string

# Docker compose mounts the volume at /data and reads this file. Running
# locally without Docker? start.ps1 / start.sh pick sane defaults and put the
# database in ./data, so this file is not needed at all.
FCLASH_DATABASE_URL=sqlite:////data/fclash.db
FCLASH_DATA_DIR=/data

# Access token lifetime (minutes) and refresh token lifetime (days).
FCLASH_ACCESS_TOKEN_MINUTES=1440
FCLASH_REFRESH_TOKEN_DAYS=180

# Largest snapshot accepted, in bytes.
FCLASH_MAX_SNAPSHOT_BYTES=8388608

# How many revisions to keep for rollback.
FCLASH_HISTORY_LIMIT=20

# Subscription refresh fetches the URL stored on a subscription. Local and
# link-local targets are refused unless this is true (useful for testing).
FCLASH_ALLOW_PRIVATE_FETCH=false

# Set to false once your own account exists.
FCLASH_ALLOW_REGISTRATION=true
